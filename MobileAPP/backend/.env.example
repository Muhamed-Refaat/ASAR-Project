PORT=3001

# The IP address of the ESP32 on the local network (used for WS connection from the relay)
ESP32_IP=192.168.1.100

# Optional: public-facing URL of this relay server (e.g. from ngrok or Cloudflare Tunnel).
# When set, the app can connect from *anywhere* using:
#   wss://<PUBLIC_URL>/ws
# You can also set this at runtime via: POST /api/tunnel { "public_url": "https://..." }
#
# --- Quick setup with ngrok ---
# 1. Install ngrok: https://ngrok.com/download
# 2. Run: ngrok http 3001
# 3. Copy the printed HTTPS forwarding URL (e.g. https://abcd1234.ngrok-free.app)
# 4. Set it here OR POST it to /api/tunnel while the backend is running
#
# --- Quick setup with Cloudflare Tunnel (free, no auth on free tier) ---
# 1. Install cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# 2. Run: cloudflared tunnel --url http://localhost:3001
# 3. Copy the printed .trycloudflare.com URL and set it below
#PUBLIC_URL=https://abcd1234.ngrok-free.app
